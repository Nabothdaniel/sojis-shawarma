rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Users can only read and write their own documents. 
      // Admins (role == 'admin') can read all users (e.g. for dashboard)
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Users can create their initial profile (must be 'user' role, or temporarily 'admin')
      allow create: if request.auth != null && request.auth.uid == userId && (request.resource.data.role == 'user' || request.resource.data.role == 'admin');
      
      // Users can update their own document, but CANNOT change their role to 'admin'
      allow update: if request.auth != null && request.auth.uid == userId && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'favorite_products', 'updatedAt']) || request.resource.data.role == resource.data.role);
      
      // Only admins can delete user documents entirely, or users themselves if account deletion is allowed
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ==========================================
    // PRODUCTS COLLECTION
    // ==========================================
    match /products/{productId} {
      // Anyone can view products (guests included, because the catalog is public)
      allow read: if true;
      
      // Only admins can add, update, or delete products
      allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // CATEGORIES COLLECTION
    // ==========================================
    match /categories/{categoryId} {
      // Anyone can view categories
      allow read: if true;
      
      // Only admins can mutate categories
      allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // ORDERS COLLECTION
    // ==========================================
    match /orders/{orderId} {
      // Allows direct URL tracking for orders using their unguessable document ID
      allow get: if true;
      
      // Protects listing querying exclusively to authorized owners or admins
      allow list: if request.auth != null && (
        resource.data.user_id == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Anyone can CREATE an order (guests included, provided they submit required data)
      allow create: if true;
      
      // Only admins can UPDATE an order (change status, confirm payment) 
      // OR users can update their order IF they are just uploading a receipt (payment_status update)
      allow update: if 
        (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth != null && resource.data.user_id == request.auth.uid) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipt_path', 'payment_status', 'payment_submitted_at', 'payment_reference', 'updated_at'])
        );
      
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // SETTINGS COLLECTION
    // ==========================================
    match /settings/{settingId} {
      // Everyone can read store settings (like payment details)
      allow read: if true;
      
      // Only admins can change store settings
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // PROMO CODES COLLECTION
    // ==========================================
    match /promo_codes/{promoId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // ADMIN INVITES COLLECTION
    // ==========================================
    match /admin_invites/{inviteId} {
      allow read, delete: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // ==========================================
    // REVIEWS & FEEDBACK COLLECTION
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /feedbacks/{feedbackId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if true;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
